export struct BookItem {
    id: int,
    title: string,
    author: string,
    format: string,
    state: string,
    cover: image,
}

component FlatButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> text-size: 22px;
    callback clicked();

    border-width: 2px;
    border-color: root.enabled ? #000000 : #999999;
    border-radius: 4px;
    background: touch.pressed ? #000000 : #ffffff;

    Text {
        text: root.label;
        color: touch.pressed ? #ffffff : (root.enabled ? #000000 : #999999);
        font-size: root.text-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component SettingRow inherits Rectangle {
    in property <length> unit;
    in property <string> label;
    in property <string> value;
    callback clicked();

    background: touch.pressed ? #cccccc : #ffffff;

    VerticalLayout {
        padding-left: root.unit * 0.4;
        padding-right: root.unit * 0.4;
        alignment: center;
        spacing: root.unit * 0.25;

        Text {
            text: root.label;
            font-size: root.unit * 0.75;
            color: #555555;
        }

        Text {
            text: root.value;
            font-size: root.unit;
            color: #000000;
            overflow: elide;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #aaaaaa;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    in property <[BookItem]> books;
    in property <string> server;
    in property <string> status;
    in property <bool> busy;
    in property <bool> settings-open;
    in property <string> page-label;
    in property <bool> has-prev;
    in property <bool> has-next;

    in property <string> cfg-server;
    in property <string> cfg-user;
    in property <string> cfg-password;
    in property <string> cfg-library;
    in property <string> cfg-download-dir;
    in property <string> cfg-formats;
    in property <string> cfg-limit;

    // Меняется, когда кадр нужно перерисовать целиком: после нативной
    // клавиатуры, которая рисует поверх нашего кадра, и после возврата из
    // фона. Значение само по себе не важно — важно, что от него зависит
    // фоновый прямоугольник во всю ширину экрана, так что любое изменение
    // помечает грязной всю область, и софтварный рендерер перерисовывает всё.
    in property <int> repaint-tick;

    callback refresh();
    callback download(int);
    callback toggle-settings();
    callback edit-field(int);
    callback prev-page();
    callback next-page();

    // Компилятор встраивает глифы только для латиницы, цифр и строковых
    // литералов, найденных в этом файле. Названия книг приходят из Rust, так
    // что нужный алфавит перечисляем здесь явно — иначе на экране будут дыры.
    // Свойство публичное намеренно: у экспортируемого компонента такие
    // свойства не вычищаются оптимизатором.
    in property <string> glyph-set: "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяІіЇїЄєҐґЎў«»„“”—–…•№±§°←→ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿĀāĆćČčĐđĘęĞğŁłŃńŇňŐőŒœŘřŚśŞşŠšŤťŰűŸŹźŻżŽž";

    // Базовый размер, от которого пляшет вся вёрстка. Масштаб экрана
    // PocketBook заранее неизвестен: логический размер зависит от dpi и scale,
    // которые сообщает прошивка.
    //
    // Считает его Rust по фактическому размеру окна и присылает сюда. Вывести
    // его прямо здесь из `root.height` нельзя: высота окна определяется
    // лэйаутом, лэйаут — размерами шрифтов, а те — этим самым свойством, то
    // есть получается петля привязок.
    in property <length> unit: 18px;
    property <length> row-height: root.unit * 4;

    // Сколько строк влезает на страницу — это же число Rust читает, чтобы
    // нарезать список.
    out property <int> rows-per-page: max(1, floor(body.height / root.row-height));

    title: "pocket_calibre";

    // Оттенок меняется на единицу из 255 — на e-ink это неотличимо от белого,
    // но достаточно, чтобы рендерер счёл область изменившейся.
    background: mod(root.repaint-tick, 2) == 0 ? #ffffff : #fefefe;

    forward-focus: keys;

    keys := FocusScope {
        // Аппаратные кнопки листания inkview-slint отдаёт как стрелки.
        key-pressed(event) => {
            if (root.settings-open) {
                return reject;
            }
            if (event.text == Key.LeftArrow || event.text == Key.PageUp) {
                root.prev-page();
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.PageDown) {
                root.next-page();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: root.unit;
            spacing: root.unit * 0.6;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "pocket_calibre";
                    font-size: root.unit * 1.4;
                    font-weight: 700;
                    color: #000000;
                }

                Text {
                    text: root.server;
                    font-size: root.unit * 0.75;
                    color: #555555;
                    overflow: elide;
                }
            }

            Rectangle {
                height: 2px;
                background: #000000;
            }

            HorizontalLayout {
                spacing: root.unit * 0.6;
                alignment: start;

                FlatButton {
                    height: root.unit * 2.6;
                    min-width: root.unit * 7;
                    text-size: root.unit;
                    label: root.busy ? "Подождите…" : "Обновить";
                    enabled: !root.busy && !root.settings-open;
                    clicked => {
                        root.refresh();
                    }
                }

                FlatButton {
                    height: root.unit * 2.6;
                    min-width: root.unit * 7;
                    text-size: root.unit;
                    label: root.settings-open ? "Готово" : "Настройки";
                    clicked => {
                        root.toggle-settings();
                    }
                }
            }

            // Область под содержимое. Ничего не прокручивается: и список книг,
            // и настройки нарезаются на страницы в Rust, потому что на e-ink
            // каждый кадр стоит полного обновления экрана.
            body := Rectangle {
                vertical-stretch: 1;

                if root.settings-open: VerticalLayout {
                    alignment: start;

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Адрес сервера";
                        value: root.cfg-server;
                        clicked => {
                            root.edit-field(0);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Логин";
                        value: root.cfg-user;
                        clicked => {
                            root.edit-field(1);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Пароль";
                        value: root.cfg-password;
                        clicked => {
                            root.edit-field(2);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Библиотека";
                        value: root.cfg-library;
                        clicked => {
                            root.edit-field(3);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Папка загрузки";
                        value: root.cfg-download-dir;
                        clicked => {
                            root.edit-field(4);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Форматы";
                        value: root.cfg-formats;
                        clicked => {
                            root.edit-field(5);
                        }
                    }

                    SettingRow {
                        unit: root.unit;
                        height: root.row-height;
                        label: "Сколько книг показывать";
                        value: root.cfg-limit;
                        clicked => {
                            root.edit-field(6);
                        }
                    }
                }

                if !root.settings-open: VerticalLayout {
                    alignment: start;

                    for book in root.books: Rectangle {
                        height: root.row-height;
                        background: row.pressed ? #cccccc : #ffffff;

                        HorizontalLayout {
                            padding-left: root.unit * 0.4;
                            padding-right: root.unit * 0.4;
                            spacing: root.unit * 0.6;

                            Image {
                                width: root.row-height * 0.62;
                                source: book.cover;
                                image-fit: contain;
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: root.unit * 0.2;

                                Text {
                                    text: book.title;
                                    font-size: root.unit;
                                    color: #000000;
                                    overflow: elide;
                                }

                                Text {
                                    text: book.author;
                                    font-size: root.unit * 0.8;
                                    color: #444444;
                                    overflow: elide;
                                }
                            }

                            Text {
                                width: root.unit * 5;
                                text: book.state == "" ? book.format : book.state;
                                font-size: root.unit * 0.8;
                                color: #000000;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #aaaaaa;
                        }

                        row := TouchArea {
                            clicked => {
                                root.download(book.id);
                            }
                        }
                    }
                }
            }

            if !root.settings-open: HorizontalLayout {
                spacing: root.unit * 0.6;

                FlatButton {
                    height: root.unit * 2.6;
                    width: root.unit * 5;
                    text-size: root.unit * 1.2;
                    label: "←";
                    enabled: root.has-prev;
                    clicked => {
                        root.prev-page();
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.page-label;
                    font-size: root.unit;
                    color: #000000;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                FlatButton {
                    height: root.unit * 2.6;
                    width: root.unit * 5;
                    text-size: root.unit * 1.2;
                    label: "→";
                    enabled: root.has-next;
                    clicked => {
                        root.next-page();
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: #000000;
            }

            Text {
                text: root.status;
                font-size: root.unit * 0.8;
                color: #000000;
                overflow: elide;
            }
        }
    }
}
